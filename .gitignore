# ==============================================================================
# Git Ignore Configuration
# Project: Agent-Assisted Multimodal Deepfake Detection via Cross-Modal Consistency Learning and Adaptive Fusion
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python, Bytecode & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Environment Secrets & Private Credentials
# ------------------------------------------------------------------------------
.env
*.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------------------------------------------
# 4. Large Datasets & Processed Media
# ------------------------------------------------------------------------------
# Raw FakeAVCeleb dataset videos and audios (~6.3 GB)
dataset/
dataset/*

# Processed frames, face crops, and audio clips
processed/
processed/*

# InsightFace pre-trained models (~325 MB)
.insightface/
.insightface/*

# ------------------------------------------------------------------------------
# 5. Temporary Uploads & Media Files
# ------------------------------------------------------------------------------
app/temp_uploads/*
!app/temp_uploads/.gitkeep

# Exclude video, audio, and large media files across experiments
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.wav
*.flac

# ------------------------------------------------------------------------------
# 6. Model Weights & Checkpoints (Excluded from Git; host via external releases)
# ------------------------------------------------------------------------------
*.pth
*.pt
*.ckpt
*.onnx
*.bin
*.safetensors
*.h5

# Explicitly keep the tiny OOD reference stats (10 KB centroid file required for reliability detector)
!experiments/phase8/ood/reference_stats.pt

# Standalone checkpoints folders
checkpoints/
checkpoints_test/
experiments/**/models/

# ------------------------------------------------------------------------------
# 7. Cached Features & Intermediate Tensors
# ------------------------------------------------------------------------------
experiments/**/features/
*.npy
*.npz
*.parquet

# ------------------------------------------------------------------------------
# 8. Generated Plots & Experimental Visualizations
# ------------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
!docs/**/*.png
!docs/*.png
!docs/**/*.jpg
!docs/*.jpg
!app/static/**/*.png
!app/static/*.png
!app/static/**/*.svg
!app/static/*.svg
!assets/**/*.png
!assets/*.png

experiments/**/plots/
experiments/**/visualizations/
experiments/demo_debug/frames/
experiments/demo_debug/videos/

# ------------------------------------------------------------------------------
# 9. Training Logs, Debug Runs & Raw Predictions
# ------------------------------------------------------------------------------
*.log
experiments/**/logs/
experiments/**/predictions/
experiments/**/debug/
experiments/demo_debug/
outputs/
outputs/*

# Raw sample prediction dumps (thousands of per-sample floating point probabilities)
*predictions*.csv
predictions.csv
predictions_*.csv
experiments/**/predictions*.csv

# Deduplicated root reports in individual experiment folders (canonical copies in metrics/ & reports/)
experiments/threshold_tuning/*.txt
experiments/threshold_tuning/*.json
!experiments/threshold_tuning/config.json
experiments/threshold_tuning/threshold_summary.csv
experiments/threshold_tuning/threshold_tuning_report.md
experiments/class_weight/classification_report.txt
experiments/class_weight/metrics.json

# Scratch repair utilities
fix_encoding.py
scratch_manifest_check.py

# ------------------------------------------------------------------------------
# 10. Operating System & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 11. Local Legacy Copies (Safely preserved on local disk; tracked in docs/ & tools/)
# ------------------------------------------------------------------------------
/PHASE8_AUDIT_REPORT.md
/PROJECT_EVIDENCE_INDEX.md
/PROJECT_REFERENCES.md
/PROJECT_RESULTS_TABLES.md
/PROJECT_SUMMARY_FOR_FINAL_REPORT.md
/PROJECT_WORKFLOW_AND_DIAGRAMS.md
/UNVERIFIED_ITEMS_AND_LIMITATIONS.md
/vision_swin_report.md
/RESEARCH_EVIDENCE_PACKAGE/
/audit_inference_investigation.py
/audit_test_set.py
/compare_offline_vs_web.py
/debug_inference_pipeline.py
/discover_experiments.py
/repair_spectrogram_cache.py
