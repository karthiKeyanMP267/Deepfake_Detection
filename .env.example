# ==============================================================================
# LLM Forensic Explanation Agent Configuration
# ==============================================================================
# The system works completely offline using local deterministic reasoning if
# no API key is provided. To enable LLM-powered natural language explanations,
# provide your provider API key below.
#
# Supported providers: openai, gemini, openai_compatible (Groq, OpenRouter, Ollama, etc.)
# ==============================================================================

# LLM API Key (Keep secret! Do not commit real keys)
LLM_API_KEY=

# LLM Provider: "openai", "gemini", or "openai_compatible"
LLM_PROVIDER=openai

# LLM Model identifier (e.g. gpt-4o-mini, gpt-4o, gemini-1.5-flash, etc.)
LLM_MODEL=gpt-4o-mini

# Optional custom Base URL (e.g. for Ollama: http://localhost:11434/v1, or OpenRouter: https://openrouter.ai/api/v1)
LLM_BASE_URL=

# Timeout in seconds for LLM calls (default: 10.0)
LLM_TIMEOUT_SEC=10.0
